{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/downloads/(.*)",
      "dest": "/downloads/$1"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/pack-du-desir",
      "dest": "/pack-du-desir.html"
    },
    {
      "src": "/fou-de-toi-folle-de-toi",
      "dest": "/fou-de-toi-folle-de-toi.html"
    },
    {
      "src": "/checkout",
      "dest": "/checkout.html"
    },
    {
      "src": "/merci",
      "dest": "/merci.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
